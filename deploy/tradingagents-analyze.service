# TradingAgents-Astock 后台分析 worker
#
# 独立消费磁盘分析队列（~/.tradingagents/analysis_queue.json）。Web 端设
# TRADINGAGENTS_ANALYSIS_EXECUTOR=worker 后只入队，关闭浏览器也会继续跑完队列。
#
# 安装：
#   sudo cp deploy/tradingagents-analyze.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tradingagents-analyze.service
#
# 与 Web 服务共享同一份代码 / venv / ~/.tradingagents 目录，通过
# ~/.tradingagents/analyze.worker.lock 保证全局只有一个 worker。
#
# 中断自动续跑（A+B+C）：
#   - 出队为 lease，心跳过期或进程重启后回收并重新入队
#   - SIGTERM 优雅停机把 in-flight 写回队列（不增加续跑次数）
#   - 启动时对有 checkpoint 的 running 孤儿自动入队
#   - TRADINGAGENTS_MAX_AUTO_RESUME 默认 2

[Unit]
Description=TradingAgents Astock Analysis Worker
After=network.target

[Service]
Type=simple
User=solo
WorkingDirectory=/home/solo/TradingAgents-astock
Environment="PATH=/home/solo/TradingAgents-astock/.venv/bin"
Environment="ARROW_DEFAULT_MEMORY_POOL=system"
Environment="TZ=Asia/Shanghai"
# 并发上限（与 Web 侧文案一致，默认 3）
Environment="TRADINGAGENTS_MAX_PARALLEL=3"
# 中断后自动续跑次数上限（lease 回收 + 启动孤儿入队共用）
Environment="TRADINGAGENTS_MAX_AUTO_RESUME=2"
# lease 心跳超时（秒）；超时后视为崩溃并回收入队
Environment="TRADINGAGENTS_QUEUE_LEASE_TTL=180"
# 美股 GUI：分析 worker 消费 US 队列时同样需要桥接路径
Environment="US_TRADINGAGENTS_ROOT=/home/solo/TradingAgents"
Environment="US_TRADINGAGENTS_PYTHON=/home/solo/TradingAgents/.venv/bin/python"
ExecStart=/home/solo/TradingAgents-astock/.venv/bin/tradingagents-analyze
Restart=always
RestartSec=5
# 给 SIGTERM 足够时间把 in-flight 写回队列后再退出
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
