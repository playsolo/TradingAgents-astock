# TradingAgents-Astock 信号准确率 — 每日 21:00（北京时间）结算
#
# 与 tradingagents-accuracy.service 成对安装。
#
# 安装：
#   sudo cp deploy/tradingagents-accuracy.service /etc/systemd/system/
#   sudo cp deploy/tradingagents-accuracy.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tradingagents-accuracy.timer

[Unit]
Description=Daily 21:00 signal accuracy settle for TradingAgents Astock

[Timer]
# 服务器时区为 Asia/Shanghai；本地时间每日 21:00
# （部分 systemd 版本不支持 OnCalendar=Asia/Shanghai ... 前缀语法）
OnCalendar=*-*-* 21:00:00
Persistent=true
Unit=tradingagents-accuracy.service

[Install]
WantedBy=timers.target
