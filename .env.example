# LLM Providers (set the one you use)
# ⚠️ 重要：填真实 key 后请勿 commit 此文件；务必在 .gitignore 中保留 .env。
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
# MiniMax 国内直连（推荐供应商）：base_url=https://api.minimaxi.com/v1
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# LLM SDK 重试预算（可选）。设置后传递给所有 provider SDK。
# 不设置则使用各 SDK 默认值（通常为 2）。提高此值可在限流部署（如 Azure
# OpenAI）上应对突发的 429 限流，避免分析任务中断。
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# 第三方中转 / 代理网关地址（可选）。设置后所有模型请求走此地址，
# 方便国内通过中转访问 Claude / OpenAI 等。Web UI 侧边栏也可直接填写。
# 例: BACKEND_URL=https://your-proxy.com/v1
BACKEND_URL=

# ---------------------------------------------------------------------------
# 美股桥接（Web 侧栏选「美股」时必需）
# 通过子进程调用原版 TradingAgents（Yahoo Finance），与本仓 A 股分析隔离。
# 生产示例：US_TRADINGAGENTS_ROOT=/home/solo/TradingAgents
# ---------------------------------------------------------------------------
#US_TRADINGAGENTS_ROOT=/path/to/TradingAgents
# 可选；不设则优先用 US_TRADINGAGENTS_ROOT/.venv/bin/python，再回退当前解释器
#US_TRADINGAGENTS_PYTHON=/path/to/TradingAgents/.venv/bin/python
